{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "nl.intergas.comforttouch",
  "version": "1.0.0",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local",
    "cloud"
  ],
  "name": {
    "en": "Intergas Comfort Touch"
  },
  "description": {
    "en": "Adds support for Intergas Comfort Touch (Gateway v3)."
  },
  "category": [
    "climate"
  ],
  "permissions": [],
  "brandColor": "#00529B",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Wouter van Outersterp",
    "email": "woutersterp@hotmail.com"
  },
  "esm": true,
  "drivers": [
    {
      "name": {
        "en": "Intergas Heater",
        "nl": "Intergas CV-ketel"
      },
      "class": "thermostat",
      "capabilities": [
        "target_temperature",
        "measure_temperature",
        "measure_water_pressure",
        "meter_gas_ch",
        "meter_gas_dhw"
      ],
      "platforms": [
        "local",
        "cloud"
      ],
      "connectivity": [
        "cloud"
      ],
      "images": {
        "small": "/drivers/intergas-heater/assets/images/small.png",
        "large": "/drivers/intergas-heater/assets/images/large.png",
        "xlarge": "/drivers/intergas-heater/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "usernameLabel": {
              "en": "E-mail address",
              "nl": "E-mailadres"
            },
            "usernamePlaceholder": {
              "en": "user@example.com",
              "nl": "gebruiker@voorbeeld.nl"
            },
            "passwordLabel": {
              "en": "Password",
              "nl": "Wachtwoord"
            },
            "passwordPlaceholder": {
              "en": "Your Intergas account password",
              "nl": "Je Intergas account wachtwoord"
            }
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Account",
            "nl": "Account"
          },
          "children": [
            {
              "id": "email",
              "type": "text",
              "label": {
                "en": "E-mail",
                "nl": "E-mailadres"
              },
              "value": ""
            },
            {
              "id": "account_id",
              "type": "text",
              "label": {
                "en": "Account ID",
                "nl": "Account-ID"
              },
              "value": ""
            },
            {
              "id": "heater_id",
              "type": "text",
              "label": {
                "en": "Heater ID",
                "nl": "Ketel-ID"
              },
              "value": ""
            },
            {
              "id": "zoneNumber",
              "type": "number",
              "label": {
                "en": "Zone number",
                "nl": "Zonenummer"
              },
              "value": 1,
              "min": 1,
              "max": 8
            }
          ]
        }
      ],
      "id": "intergas-heater"
    }
  ],
  "capabilities": {
    "measure_water_pressure": {
      "type": "number",
      "title": {
        "en": "Water pressure",
        "nl": "Waterdruk"
      },
      "units": {
        "en": "bar"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icon.svg"
    },
    "meter_gas_ch": {
      "type": "number",
      "title": {
        "en": "Gas consumption CH",
        "nl": "Gasverbruik CV"
      },
      "units": {
        "en": "m³"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icon.svg",
      "decimals": 3
    },
    "meter_gas_dhw": {
      "type": "number",
      "title": {
        "en": "Gas consumption DHW",
        "nl": "Gasverbruik tapwater"
      },
      "units": {
        "en": "m³"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icon.svg",
      "decimals": 3
    }
  }
}