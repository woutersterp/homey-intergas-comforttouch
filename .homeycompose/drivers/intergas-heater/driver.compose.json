{
  "id": "intergas-heater",
  "name": {
    "en": "Intergas Heater",
    "nl": "Intergas CV-ketel"
  },
  "class": "thermostat",
  "capabilities": [
    "target_temperature",
    "measure_temperature",
    "measure_water_pressure",
    "meter_gas_ch",
    "meter_gas_dhw"
  ],
  "capabilitiesOptions": {},
  "platforms": ["local", "cloud"],
  "connectivity": ["cloud"],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "pair": [
    {
      "id": "login_credentials",
      "template": "login_credentials",
      "options": {
        "usernameLabel": {
          "en": "E-mail address",
          "nl": "E-mailadres"
        },
        "usernamePlaceholder": {
          "en": "user@example.com",
          "nl": "gebruiker@voorbeeld.nl"
        },
        "passwordLabel": {
          "en": "Password",
          "nl": "Wachtwoord"
        }
      }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Account",
        "nl": "Account"
      },
      "children": [
        {
          "id": "email",
          "type": "text",
          "label": {
            "en": "E-mail",
            "nl": "E-mailadres"
          },
          "value": ""
        }
      ]
    }
  ]
}
