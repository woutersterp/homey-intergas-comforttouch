{
  "extends": "athom/homey-app",
  "settings": {
    "import/resolver": {
      "typescript": {
        "alwaysTryTypes": true
      }
    },
    "import/core-modules": ["homey"]
  },
  "rules": {
    "import/extensions": ["error", "ignorePackages", { "ts": "never", "tsx": "never", "js": "never" }]
  },
  "overrides": [
    {
      "files": ["*.ts"],
      "rules": {
        "node/no-missing-import": "off"
      }
    }
  ]
}
